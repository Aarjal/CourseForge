# Server environment configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas or local connection string
MONGO_URI=mongodb://localhost:27017/courseforge

# Allowed client origins for CORS (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,https://aarjal.github.io

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Seed admin user (used by npm run seed:admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@courseforge.dev
ADMIN_PASSWORD=admin123
